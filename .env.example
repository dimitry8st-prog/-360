REDIS_URL=redis://redis:6379/0
MAX_FILE_SIZE=20MB
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs
FILE_RETENTION_DAYS=30
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_DAILY_REQUEST_LIMIT=25
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ADMIN_EMAIL=admin@example.com
